# Copy to .env (or .env.local) and fill in what you need, then rebuild.

# Public URL of the site - used for the social share image and canonical link.
VITE_SITE_URL=https://genxmeta.io

# Launch date/time for the countdown (ISO 8601 with timezone).
# Leave empty to hide the countdown and show "Launching soon" instead.
# e.g. VITE_LAUNCH_DATE=2026-12-01T10:00:00+05:30
VITE_LAUNCH_DATE=

# URL that accepts POST {"email": "..."} as JSON for the "Get notified" form.
# Leave empty to hide the form (the share button still shows).
VITE_NOTIFY_ENDPOINT=
